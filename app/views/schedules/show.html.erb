<p>
  <strong>Title:</strong>
  <%= @schedule.title %>
</p>

<p>
  <strong>Start date:</strong>
  <%= @schedule.start_date&.strftime("%Y/%m/%d") %>
</p>

<p>
  <strong>End date:</strong>
  <%= @schedule.end_date&.strftime("%Y/%m/%d") %>
</p>

<p>
  <strong>All day:</strong>
  <%= @schedule.all_day ? "○" : "" %>
</p>

<p>
  <strong>Memo:</strong>
  <%= @schedule.memo %>
</p>

<%= link_to "Edit this schedule", edit_schedule_path(@schedule) %> |
<%= link_to "Back to schedules", schedules_path %> |
<%= link_to "Destroy", schedule_path(@schedule),
    data: { turbo_method: :delete, turbo_confirm: "予定を削除しますか？" } %>
